{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/dashboard.schema.json",
  "title": "Dashboard Config Schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "dashboardId",
    "dashboardName",
    "dataSources",
    "widgets",
    "layout"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "dashboardId": {
      "type": "string"
    },
    "dashboardName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "settings": {
      "type": "object",
      "properties": {
        "nearExpiryDays": {
          "type": "number",
          "minimum": 1
        },
        "criticalDays": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "theme": {
      "type": "object"
    },
    "formatters": {
      "type": "object"
    },
    "referenceTables": {
      "type": "object"
    },
    "dataSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["local", "url", "inline"]
          },
          "accept": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string"
          },
          "fieldTypes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "dateParsing": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["as", "expr"],
        "properties": {
          "as": {
            "type": "string"
          },
          "expr": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "filters": {
      "type": "object"
    },
    "layout": {
      "type": "object",
      "required": ["type", "columns", "rowHeight"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["grid"]
        },
        "columns": {
          "type": "number",
          "minimum": 1
        },
        "rowHeight": {
          "type": "number",
          "minimum": 1
        },
        "desktop": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["widgetId"],
            "properties": {
              "widgetId": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        },
        "mobile": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["widgetId"],
            "properties": {
              "widgetId": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "widgets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "kpi",
              "bar",
              "line",
              "pareto",
              "stackedBar",
              "table",
              "actionBar"
            ]
          },
          "title": {
            "type": "string"
          },
          "dataSource": {
            "type": "string"
          },
          "query": {
            "type": "object"
          },
          "encoding": {
            "type": "object"
          },
          "tooltip": {
            "type": "object"
          },
          "display": {
            "type": "object"
          },
          "interactions": {
            "type": "object"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "analytics": {
            "type": "object",
            "properties": {
              "movingAverage": {
                "type": "object",
                "required": ["field", "window", "as"],
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "window": {
                    "type": "number",
                    "minimum": 2
                  },
                  "as": {
                    "type": "string"
                  }
                }
              }
            },
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "actionBar"
                }
              }
            },
            "then": {
              "not": {
                "required": ["dataSource"]
              }
            },
            "else": {
              "required": ["dataSource"]
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
