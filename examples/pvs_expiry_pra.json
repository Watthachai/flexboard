{
  "schemaVersion": "1.3",
  "dashboardId": "pvs-co-ltd-inventory-aging-report",
  "dashboardName": "PVS Inventory Aging Analysis",
  "description": "Clean dashboard with updated data structure",
  "version": 8,

  "theme": {
    "dark": true,
    "brandColor": "#7c3aed",
    "radius": "20px",
    "statusColors": {
      "ok": "#10b981",
      "warning": "#f59e0b",
      "danger": "#ef4444"
    }
  },

  "settings": { "nearExpiryDays": 45, "criticalDays": 14 },

  "formatters": {
    "date": {
      "kind": "date",
      "timezone": "Asia/Bangkok",
      "pattern": "dd MMM yyyy"
    },
    "qty": {
      "kind": "number",
      "precision": 0,
      "thousandsSep": ",",
      "roundingMode": "round"
    },
    "unitCost": {
      "kind": "number",
      "precision": 6,
      "thousandsSep": ",",
      "prefix": "฿",
      "roundingMode": "round"
    },
    "money": {
      "kind": "number",
      "precision": 2,
      "thousandsSep": ",",
      "prefix": "฿",
      "roundingMode": "round"
    },
    "days": {
      "kind": "number",
      "precision": 0,
      "roundingMode": "round"
    }
  },

  "dataSources": [
    {
      "id": "uploaded-xml",
      "type": "local",
      "accept": [".xml", ".csv", ".json"],
      "fieldTypes": {
        "ID": "string",
        "DataDate": "date",
        "Corp": "string",
        "Branch": "string",
        "Prod": "string",
        "UnitName": "string",
        "DocNumber": "string",
        "DocDate": "date",
        "QtyFromThisDoc": "number",
        "AverageCost": "number"
      },
      "dateParsing": {
        "DataDate": "yyyy-MM-dd",
        "DocDate": "yyyy-MM-dd"
      }
    }
  ],

  "transforms": [
    { "as": "QtySafe", "expr": "coalesce(QtyFromThisDoc, 0)" },
    { "as": "CostSafe", "expr": "coalesce(AverageCost, 0)" },
    { "as": "DaysAge", "expr": "dateDiff(DataDate, DocDate, 'days')" },
    {
      "as": "AgeBucket",
      "expr": "case(DaysAge > 365, '>365', DaysAge > 180, '181-365', DaysAge > 90, '91-180', true, '0-90')"
    },
    { "as": "TotalValueRow", "expr": "QtySafe * CostSafe" },
    {
      "as": "Qty_0_90_row",
      "expr": "case(AgeBucket = '0-90', QtySafe, true, 0)"
    },
    {
      "as": "Val_0_90_row",
      "expr": "case(AgeBucket = '0-90', TotalValueRow, true, 0)"
    },
    {
      "as": "Qty_91_180_row",
      "expr": "case(AgeBucket = '91-180', QtySafe, true, 0)"
    },
    {
      "as": "Val_91_180_row",
      "expr": "case(AgeBucket = '91-180', TotalValueRow, true, 0)"
    },
    {
      "as": "Qty_181_365_row",
      "expr": "case(AgeBucket = '181-365', QtySafe, true, 0)"
    },
    {
      "as": "Val_181_365_row",
      "expr": "case(AgeBucket = '181-365', TotalValueRow, true, 0)"
    },
    {
      "as": "Qty_365_plus_row",
      "expr": "case(AgeBucket = '>365', QtySafe, true, 0)"
    },
    {
      "as": "Val_365_plus_row",
      "expr": "case(AgeBucket = '>365', TotalValueRow, true, 0)"
    }
  ],

  "globalFilters": [
    {
      "field": "DataDate",
      "op": ">=",
      "value": "addMonths(endOfMonth(today()), -6)",
      "description": "ตั้งแต่สิ้นเดือนที่ 6 เดือนย้อนหลัง"
    },
    {
      "field": "DataDate",
      "op": "<=",
      "value": "endOfMonth(today())",
      "description": "จนถึงสิ้นเดือนปัจจุบัน"
    }
  ],

  "userFilters": [
    {
      "id": "period-filter",
      "field": "DataDate",
      "label": "ช่วงเวลาข้อมูล",
      "type": "select",
      "defaultValue": "last_7_months",
      "options": [
        {
          "label": "7 เดือนล่าสุด (ปัจจุบัน + ย้อนหลัง 6 เดือน)",
          "value": "last_7_months",
          "filter": null
        },
        {
          "label": "ทุกข้อมูล (ไม่กรอง)",
          "value": "all_data",
          "filter": null
        }
      ]
    },
    {
      "id": "month-filter",
      "field": "DataDate",
      "label": "เลือกเดือนเฉพาะ",
      "type": "month-end-dropdown",
      "defaultValue": "all",
      "description": "เลือกข้อมูลเฉพาะเดือนสิ้นเดือน",
      "monthsBack": 6,
      "autoGenerate": true
    }
  ],

  "widgets": [
    {
      "id": "kpi-0-90",
      "type": "kpi",
      "title": "0-90 Days (Fresh)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": "0-90" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "ok" }]
      }
    },
    {
      "id": "kpi-91-180",
      "type": "kpi",
      "title": "91-180 Days (Aging)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": "91-180" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "warning" }]
      }
    },
    {
      "id": "kpi-181-365",
      "type": "kpi",
      "title": "181-365 Days (Risk)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": "181-365" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "danger" }]
      }
    },
    {
      "id": "kpi-over-365",
      "type": "kpi",
      "title": ">365 Days (Old Stock)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": ">365" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "danger" }]
      }
    },

    {
      "id": "table-summary-by-product",
      "type": "table",
      "title": "Inventory Aging Summary by Product",
      "dataSource": "uploaded-xml",
      "query": {
        "groupBy": ["Corp", "Branch", "Prod", "UnitName"],
        "measures": [
          { "field": "Qty_0_90_row", "agg": "sum", "as": "Qty_0_90" },
          { "field": "Val_0_90_row", "agg": "sum", "as": "Val_0_90" },
          { "field": "Qty_91_180_row", "agg": "sum", "as": "Qty_91_180" },
          { "field": "Val_91_180_row", "agg": "sum", "as": "Val_91_180" },
          { "field": "Qty_181_365_row", "agg": "sum", "as": "Qty_181_365" },
          { "field": "Val_181_365_row", "agg": "sum", "as": "Val_181_365" },
          { "field": "Qty_365_plus_row", "agg": "sum", "as": "Qty_365_plus" },
          { "field": "Val_365_plus_row", "agg": "sum", "as": "Val_365_plus" },
          { "field": "TotalValueRow", "agg": "sum", "as": "TotalValue" },
          { "field": "QtyFromThisDoc", "agg": "sum", "as": "TotalQty" }
        ],
        "sort": [{ "field": "Prod", "dir": "asc" }]
      },
      "display": {
        "widgetKind": "AdvancedTableWidget",
        "searchable": true,
        "enableExportExcel": true,
        "exportExcelOptions": {
          "filename": "PVS_Inventory_Aging_Summary",
          "includeColumnGroups": true,
          "mergeGroupHeaders": true,
          "includeFilters": true,
          "includeTotals": true,
          "includeTimestamp": true,
          "worksheetName": "Summary by Product",
          "headerStyles": {
            "font": { "bold": true, "size": 12 },
            "fill": { "fgColor": { "rgb": "E8F4FD" } },
            "border": {
              "top": { "style": "thin" },
              "bottom": { "style": "thin" }
            }
          },
          "groupHeaderStyles": {
            "font": { "bold": true, "size": 11 },
            "fill": { "fgColor": { "rgb": "D1E7FF" } },
            "alignment": { "horizontal": "center" }
          }
        },
        "stickyHeader": true,
        "stickyFirstColumns": 4,
        "horizontalScroll": true,
        "pageSize": 25,
        "pageSizeOptions": [10, 25, 50, 100],

        "columnGroups": [
          {
            "title": "Product Info",
            "columns": ["Corp", "Branch", "Prod", "UnitName"]
          },
          {
            "title": "Total",
            "columns": ["TotalQty", "TotalValue"]
          },
          {
            "title": "0-90 Days",
            "columns": ["Qty_0_90", "Val_0_90"]
          },
          {
            "title": "91-180 Days",
            "columns": ["Qty_91_180", "Val_91_180"]
          },
          {
            "title": "181-365 Days",
            "columns": ["Qty_181_365", "Val_181_365"]
          },
          {
            "title": "Over 365 Days",
            "columns": ["Qty_365_plus", "Val_365_plus"]
          }
        ],

        "columnLabels": {
          "Corp": "บริษัท",
          "Branch": "สาขา",
          "Prod": "สินค้า",
          "UnitName": "หน่วย",
          "TotalQty": "Quantity",
          "TotalValue": "Total Value",
          "Qty_0_90": "Quantity",
          "Val_0_90": "Value",
          "Qty_91_180": "Quantity",
          "Val_91_180": "Value",
          "Qty_181_365": "Quantity",
          "Val_181_365": "Value",
          "Qty_365_plus": "Quantity",
          "Val_365_plus": "Value"
        },

        "columnFormatters": {
          "Qty_0_90": "qty",
          "Val_0_90": "money",
          "Qty_91_180": "qty",
          "Val_91_180": "money",
          "Qty_181_365": "qty",
          "Val_181_365": "money",
          "Qty_365_plus": "qty",
          "Val_365_plus": "money",
          "TotalQty": "qty",
          "TotalValue": "money"
        },

        "columnAlignment": {
          "Qty_0_90": "right",
          "Val_0_90": "right",
          "Qty_91_180": "right",
          "Val_91_180": "right",
          "Qty_181_365": "right",
          "Val_181_365": "right",
          "Qty_365_plus": "right",
          "Val_365_plus": "right",
          "TotalQty": "right",
          "TotalValue": "right"
        },

        "columnWidths": {
          "Corp": 120,
          "Branch": 100,
          "Prod": 200,
          "UnitName": 80,
          "TotalQty": 100,
          "TotalValue": 120,
          "Qty_0_90": 90,
          "Val_0_90": 110,
          "Qty_91_180": 90,
          "Val_91_180": 110,
          "Qty_181_365": 90,
          "Val_181_365": 110,
          "Qty_365_plus": 90,
          "Val_365_plus": 110
        },

        "showTotalsRow": true,
        "totalsAgg": {
          "Qty_0_90": "sum",
          "Val_0_90": "sum",
          "Qty_91_180": "sum",
          "Val_91_180": "sum",
          "Qty_181_365": "sum",
          "Val_181_365": "sum",
          "Qty_365_plus": "sum",
          "Val_365_plus": "sum",
          "TotalQty": "sum",
          "TotalValue": "sum"
        },

        "rowClassRules": [
          {
            "when": { "field": "Qty_365_plus", "op": ">", "value": 0 },
            "className": "bg-orange-50 border-l-4 border-orange-500"
          },
          {
            "when": { "field": "Qty_181_365", "op": ">", "value": 0 },
            "className": "bg-yellow-50 border-l-4 border-yellow-500"
          }
        ]
      }
    },

    {
      "id": "table-raw-aging-matrix",
      "type": "table",
      "title": "Raw Inventory Records - All Transactions",
      "dataSource": "uploaded-xml",
      "query": {
        "columns": [
          "ID",
          "DataDate",
          "Corp",
          "Branch",
          "Prod",
          "UnitName",
          "DocNumber",
          "DocDate",
          "QtyFromThisDoc",
          "AverageCost",
          "DaysAge",
          "AgeBucket",
          "TotalValueRow"
        ],
        "sort": [{ "field": "Prod", "dir": "asc" }]
      },
      "display": {
        "widgetKind": "AdvancedTableWidget",
        "searchable": true,
        "enableExportExcel": true,
        "exportExcelOptions": {
          "filename": "PVS_Raw_Inventory_Transactions",
          "includeColumnGroups": true,
          "mergeGroupHeaders": true,
          "includeFilters": true,
          "includeTotals": true,
          "includeTimestamp": true,
          "worksheetName": "Raw Transaction Data",
          "headerStyles": {
            "font": { "bold": true, "size": 12 },
            "fill": { "fgColor": { "rgb": "F0F9FF" } },
            "border": {
              "top": { "style": "thin" },
              "bottom": { "style": "thin" }
            }
          },
          "groupHeaderStyles": {
            "font": { "bold": true, "size": 11 },
            "fill": { "fgColor": { "rgb": "DBEAFE" } },
            "alignment": { "horizontal": "center" }
          },
          "autoWidth": true,
          "freezeRows": 2,
          "freezeCols": 3
        },
        "stickyHeader": true,
        "stickyFirstColumns": 3,
        "pageSize": 50,
        "pageSizeOptions": [25, 50, 100, 200, 500],

        "columnGroups": [
          {
            "title": "Basic Information",
            "columns": [
              "ID",
              "DataDate",
              "Corp",
              "Branch",
              "Prod",
              "UnitName",
              "DocNumber",
              "DocDate"
            ]
          },
          {
            "title": "Transaction Details",
            "columns": ["QtyFromThisDoc", "AverageCost", "TotalValueRow"]
          },
          {
            "title": "Age Calculation",
            "columns": ["DaysAge", "AgeBucket"]
          }
        ],

        "columnLabels": {
          "ID": "ID",
          "DataDate": "Data Date",
          "Corp": "บริษัท",
          "Branch": "สาขา",
          "Prod": "สินค้า",
          "UnitName": "หน่วย",
          "DocNumber": "Document No",
          "DocDate": "Document Date",
          "QtyFromThisDoc": "Quantity",
          "AverageCost": "Unit Cost",
          "DaysAge": "Days Age",
          "AgeBucket": "Age Bucket",
          "TotalValueRow": "Total Value"
        },

        "columnFormatters": {
          "DataDate": "date",
          "DocDate": "date",
          "QtyFromThisDoc": "qty",
          "AverageCost": "unitCost",
          "TotalValueRow": "money",
          "DaysAge": "days"
        },

        "showTotalsRow": true,
        "totalsAgg": {
          "QtyFromThisDoc": "sum",
          "TotalValueRow": "sum"
        },

        "columnWidths": {
          "ID": 100,
          "DataDate": 110,
          "Corp": 120,
          "Branch": 100,
          "Prod": 200,
          "UnitName": 80,
          "DocNumber": 150,
          "DocDate": 110,
          "QtyFromThisDoc": 100,
          "AverageCost": 120,
          "TotalValueRow": 130,
          "DaysAge": 80,
          "AgeBucket": 100
        },

        "columnAlignment": {
          "QtyFromThisDoc": "right",
          "AverageCost": "right",
          "TotalValueRow": "right",
          "DaysAge": "right"
        },

        "rowClassRules": [
          {
            "when": { "field": "AgeBucket", "op": "=", "value": "0-90" },
            "className": "bg-green-50 border-l-4 border-green-500"
          },
          {
            "when": { "field": "AgeBucket", "op": "=", "value": "91-180" },
            "className": "bg-yellow-50 border-l-4 border-yellow-500"
          },
          {
            "when": { "field": "AgeBucket", "op": "=", "value": "181-365" },
            "className": "bg-orange-50 border-l-4 border-orange-500"
          },
          {
            "when": { "field": "AgeBucket", "op": "=", "value": ">365" },
            "className": "bg-red-50 border-l-4 border-red-500"
          }
        ]
      }
    }
  ],

  "layout": {
    "type": "grid",
    "columns": 12,
    "rowHeight": 50,
    "desktop": [
      { "widgetId": "kpi-0-90", "x": 0, "y": 0, "width": 3, "height": 3 },
      { "widgetId": "kpi-91-180", "x": 3, "y": 0, "width": 3, "height": 3 },
      { "widgetId": "kpi-181-365", "x": 6, "y": 0, "width": 3, "height": 3 },
      { "widgetId": "kpi-over-365", "x": 9, "y": 0, "width": 3, "height": 3 },
      {
        "widgetId": "table-summary-by-product",
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 10
      },
      {
        "widgetId": "table-raw-aging-matrix",
        "x": 0,
        "y": 13,
        "width": 12,
        "height": 10
      }
    ],
    "mobile": [
      { "widgetId": "kpi-0-90" },
      { "widgetId": "kpi-91-180" },
      { "widgetId": "kpi-181-365" },
      { "widgetId": "kpi-over-365" },
      { "widgetId": "table-summary-by-product" },
      { "widgetId": "table-raw-aging-matrix" }
    ]
  }
}
