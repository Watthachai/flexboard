{
  "targetTeams": ["default"],
  "schemaVersion": "1.0",
  "description": "Dashboard description",
  "version": 1,
  "filters": {
    "global": []
  },
  "widgets": [
    {
      "id": "kpi-total",
      "type": "kpi",
      "title": "รวม QtyFromThisDoc",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [
          {
            "field": "QtyFromThisDoc",
            "agg": "sum",
            "as": "TotalQty"
          }
        ]
      },
      "display": {
        "valueFormatter": "qty"
      },
      "tooltip": {
        "template": "รวมทั้งหมด: {{ format TotalQty 'qty' }}"
      }
    },
    {
      "id": "bar-top-prod",
      "type": "bar",
      "title": "Top 10 สินค้า ตาม QtyFromThisDoc",
      "dataSource": "uploaded-xml",
      "query": {
        "dimensions": ["Prod"],
        "measures": [
          {
            "field": "QtyFromThisDoc",
            "agg": "sum",
            "as": "SumVal"
          }
        ],
        "sort": [
          {
            "field": "SumVal",
            "dir": "desc"
          }
        ],
        "limit": 10
      },
      "encoding": {
        "x": {
          "field": "SumVal",
          "type": "quantitative",
          "formatter": "qty"
        },
        "y": {
          "field": "Prod",
          "type": "nominal"
        }
      },
      "tooltip": {
        "template": "<b>{{ Prod }}</b><br/>ปริมาณ: {{ format SumVal 'qty' }}"
      }
    },
    {
      "id": "bar-branch",
      "type": "bar",
      "title": "ปริมาณตามสาขา",
      "dataSource": "uploaded-xml",
      "query": {
        "dimensions": ["Branch"],
        "measures": [
          {
            "field": "QtyFromThisDoc",
            "agg": "sum",
            "as": "SumQty"
          }
        ],
        "sort": [
          {
            "field": "SumQty",
            "dir": "desc"
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "SumQty",
          "type": "quantitative",
          "formatter": "qty"
        },
        "y": {
          "field": "Branch",
          "type": "nominal"
        }
      },
      "tooltip": {
        "template": "<b>{{ Branch }}</b><br/>ปริมาณ: {{ format SumQty 'qty' }}"
      }
    },
    {
      "id": "table-raw-data",
      "type": "table",
      "title": "ข้อมูลดิบ",
      "dataSource": "uploaded-xml",
      "query": {
        "columns": [
          "DataDate",
          "Corp",
          "Branch",
          "Prod",
          "UnitName",
          "DocNumber",
          "DocDate",
          "QtyFromThisDoc",
          "AverageCost"
        ],
        "sort": [
          {
            "field": "DataDate",
            "dir": "desc"
          }
        ]
      },
      "display": {
        "columnFormatters": {
          "DataDate": "date",
          "DocDate": "date",
          "QtyFromThisDoc": "qty",
          "AverageCost": "money"
        },
        "pageSize": 25,
        "stickyHeader": true
      }
    }
  ],
  "dashboardName": "PVS Inventory Report (Simple)",
  "layout": {
    "type": "grid",
    "columns": 12,
    "rowHeight": 50,
    "desktop": [
      {
        "widgetId": "kpi-total",
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 4
      },
      {
        "widgetId": "bar-top-prod",
        "x": 0,
        "y": 4,
        "width": 6,
        "height": 10
      },
      {
        "widgetId": "bar-branch",
        "x": 6,
        "y": 4,
        "width": 6,
        "height": 10
      },
      {
        "widgetId": "table-raw-data",
        "x": 0,
        "y": 14,
        "width": 12,
        "height": 12
      }
    ],
    "mobile": [
      {
        "widgetId": "kpi-total"
      },
      {
        "widgetId": "bar-top-prod"
      },
      {
        "widgetId": "bar-branch"
      },
      {
        "widgetId": "table-raw-data"
      }
    ]
  },
  "formatters": {
    "date": {
      "kind": "date",
      "timezone": "Asia/Bangkok",
      "pattern": "dd MMM yyyy"
    },
    "qty": {
      "kind": "number",
      "precision": 0,
      "thousandsSep": ","
    },
    "money": {
      "kind": "number",
      "precision": 2,
      "thousandsSep": ",",
      "prefix": "฿"
    }
  },
  "dashboardId": "inventory-report-simple",
  "theme": {
    "brandColor": "#7c3aed",
    "dark": true,
    "radius": "20px",
    "statusColors": {
      "warning": "#f59e0b",
      "danger": "#ef4444",
      "ok": "#10b981"
    }
  },
  "dataSources": [
    {
      "id": "uploaded-xml",
      "type": "local",
      "accept": [".csv", ".json", ".xml"],
      "fieldTypes": {
        "DataDate": "date",
        "Corp": "string",
        "Branch": "string",
        "Prod": "string",
        "UnitName": "string",
        "DocNumber": "string",
        "DocDate": "date",
        "QtyFromThisDoc": "number",
        "AverageCost": "number"
      },
      "dateParsing": {
        "DataDate": "yyyy-MM-dd",
        "DocDate": "yyyy-MM-dd"
      }
    }
  ]
}
