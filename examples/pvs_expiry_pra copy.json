{
  "schemaVersion": "1.3",
  "dashboardId": "pvs-co-ltd-inventory-aging-report",
  "dashboardName": "PVS Inventory Aging Summary",
  "description": "RAW + Matrix-style header (show all rows) + Totals + Export",
  "version": 5,

  "theme": {
    "dark": true,
    "brandColor": "#7c3aed",
    "radius": "20px",
    "statusColors": {
      "ok": "#10b981",
      "warning": "#f59e0b",
      "danger": "#ef4444"
    }
  },

  "settings": { "nearExpiryDays": 45, "criticalDays": 14 },

  "formatters": {
    "date": {
      "kind": "date",
      "timezone": "Asia/Bangkok",
      "pattern": "dd MMM yyyy"
    },
    "qty": { "kind": "number", "precision": 0, "thousandsSep": "," },
    "money": {
      "kind": "number",
      "precision": 2,
      "thousandsSep": ",",
      "prefix": "฿"
    },
    "days": { "kind": "number", "precision": 0 }
  },

  "dataSources": [
    {
      "id": "uploaded-xml",
      "type": "local",
      "accept": [".xml", ".csv", ".json"],
      "fieldTypes": {
        "DataDate": "date",
        "Corp": "string",
        "Branch": "string",
        "Prod": "string",
        "UnitName": "string",
        "DocNumber": "string",
        "DocDate": "date",
        "QtyFromThisDoc": "number",
        "AverageCost": "number"
      },
      "dateParsing": { "DataDate": "yyyy-MM-dd", "DocDate": "yyyy-MM-dd" }
    }
  ],

  "transforms": [
    { "as": "DaysAge", "expr": "dateDiff(DataDate, DocDate, 'days')" },
    {
      "as": "AgeBucket",
      "expr": "case(DaysAge < 0, 'Expired', DaysAge <= 90, '0-90', DaysAge <= 180, '91-180', DaysAge <= 365, '181-365', true, '>365')"
    },
    { "as": "TotalValueRow", "expr": "QtyFromThisDoc * AverageCost" },

    {
      "as": "Qty_Expired_row",
      "expr": "iif(AgeBucket='Expired',  QtyFromThisDoc, 0)"
    },
    {
      "as": "Val_Expired_row",
      "expr": "iif(AgeBucket='Expired',  TotalValueRow,  0)"
    },

    {
      "as": "Qty_0_90_row",
      "expr": "iif(AgeBucket='0-90',     QtyFromThisDoc, 0)"
    },
    {
      "as": "Val_0_90_row",
      "expr": "iif(AgeBucket='0-90',     TotalValueRow,  0)"
    },

    {
      "as": "Qty_91_180_row",
      "expr": "iif(AgeBucket='91-180',   QtyFromThisDoc, 0)"
    },
    {
      "as": "Val_91_180_row",
      "expr": "iif(AgeBucket='91-180',   TotalValueRow,  0)"
    },

    {
      "as": "Qty_181_365_row",
      "expr": "iif(AgeBucket='181-365',  QtyFromThisDoc, 0)"
    },
    {
      "as": "Val_181_365_row",
      "expr": "iif(AgeBucket='181-365',  TotalValueRow,  0)"
    },

    {
      "as": "Qty_365_plus_row",
      "expr": "iif(AgeBucket='>365',     QtyFromThisDoc, 0)"
    },
    {
      "as": "Val_365_plus_row",
      "expr": "iif(AgeBucket='>365',     TotalValueRow,  0)"
    }
  ],

  "widgets": [
    {
      "id": "kpi-0-90",
      "type": "kpi",
      "title": "0–90 วัน (สดใหม่)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": "0-90" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "ok" }]
      }
    },
    {
      "id": "kpi-91-180",
      "type": "kpi",
      "title": "91–180 วัน (เริ่มเก่า)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": "91-180" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "warning" }]
      }
    },
    {
      "id": "kpi-181-365",
      "type": "kpi",
      "title": "181–365 วัน (เสี่ยง)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": "181-365" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "danger" }]
      }
    },
    {
      "id": "kpi-over-365",
      "type": "kpi",
      "title": ">365 วัน (เก่าเก็บ)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": ">365" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "danger" }]
      }
    },

    {
      "id": "table-raw-aging-matrix",
      "type": "table",
      "title": "Raw Records (All Rows) — Matrix Header",
      "dataSource": "uploaded-xml",
      "query": {
        "columns": [
          "DataDate",
          "Corp",
          "Branch",
          "Prod",
          "UnitName",
          "DocNumber",
          "DocDate",
          "QtyFromThisDoc",
          "AverageCost",
          "DaysAge",
          "AgeBucket",
          "TotalValueRow",

          "Qty_Expired_row",
          "Val_Expired_row",
          "Qty_0_90_row",
          "Val_0_90_row",
          "Qty_91_180_row",
          "Val_91_180_row",
          "Qty_181_365_row",
          "Val_181_365_row",
          "Qty_365_plus_row",
          "Val_365_plus_row"
        ],
        "sort": [{ "field": "Prod", "dir": "asc" }]
      },
      "display": {
        "widgetKind": "AdvancedTableWidget",
        "enableSearch": true,
        "enableExportExcel": true,
        "stickyHeader": true,
        "stickyFirstColumns": 3,
        "rowVirtualization": true,
        "pageSize": 50,
        "pageSizeOptions": [25, 50, 100, 200, 500],

        "columnGroups": [
          {
            "title": "",
            "columns": [
              "DataDate",
              "Corp",
              "Branch",
              "Prod",
              "UnitName",
              "DocNumber",
              "DocDate",
              "QtyFromThisDoc",
              "AverageCost",
              "DaysAge",
              "AgeBucket",
              "TotalValueRow"
            ]
          },
          {
            "title": "Expired",
            "columns": ["Qty_Expired_row", "Val_Expired_row"]
          },
          { "title": "0–90 Days", "columns": ["Qty_0_90_row", "Val_0_90_row"] },
          {
            "title": "91–180 Days",
            "columns": ["Qty_91_180_row", "Val_91_180_row"]
          },
          {
            "title": "181–365 Days",
            "columns": ["Qty_181_365_row", "Val_181_365_row"]
          },
          {
            "title": "Over 365 Days",
            "columns": ["Qty_365_plus_row", "Val_365_plus_row"]
          }
        ],

        "columnLabels": {
          "DataDate": "วันที่ข้อมูล",
          "Corp": "บริษัท",
          "Branch": "สาขา",
          "Prod": "สินค้า",
          "UnitName": "หน่วย",
          "DocNumber": "เลขที่เอกสาร",
          "DocDate": "วันที่เอกสาร",
          "QtyFromThisDoc": "Quantity",
          "AverageCost": "Unit Cost",
          "DaysAge": "Days Age",
          "AgeBucket": "Bucket",
          "TotalValueRow": "Total Value",

          "Qty_Expired_row": "Quantity",
          "Val_Expired_row": "Value",
          "Qty_0_90_row": "Quantity",
          "Val_0_90_row": "Value",
          "Qty_91_180_row": "Quantity",
          "Val_91_180_row": "Value",
          "Qty_181_365_row": "Quantity",
          "Val_181_365_row": "Value",
          "Qty_365_plus_row": "Quantity",
          "Val_365_plus_row": "Value"
        },

        "columnFormatters": {
          "DataDate": "date",
          "DocDate": "date",
          "QtyFromThisDoc": "qty",
          "AverageCost": "money",
          "TotalValueRow": "money",
          "DaysAge": "days",

          "Qty_Expired_row": "qty",
          "Val_Expired_row": "money",
          "Qty_0_90_row": "qty",
          "Val_0_90_row": "money",
          "Qty_91_180_row": "qty",
          "Val_91_180_row": "money",
          "Qty_181_365_row": "qty",
          "Val_181_365_row": "money",
          "Qty_365_plus_row": "qty",
          "Val_365_plus_row": "money"
        },

        "showTotalsRow": true,
        "totalsAgg": {
          "QtyFromThisDoc": "sum",
          "TotalValueRow": "sum",

          "Qty_Expired_row": "sum",
          "Val_Expired_row": "sum",
          "Qty_0_90_row": "sum",
          "Val_0_90_row": "sum",
          "Qty_91_180_row": "sum",
          "Val_91_180_row": "sum",
          "Qty_181_365_row": "sum",
          "Val_181_365_row": "sum",
          "Qty_365_plus_row": "sum",
          "Val_365_plus_row": "sum"
        },

        "rowClassRules": [
          {
            "when": { "field": "AgeBucket", "op": "=", "value": "Expired" },
            "className": "bg-red-900/20"
          },
          {
            "when": { "field": "AgeBucket", "op": "=", "value": "0-90" },
            "className": "bg-yellow-900/30"
          },
          {
            "when": { "field": "AgeBucket", "op": "=", "value": "91-180" },
            "className": "bg-orange-900/20"
          }
        ]
      }
    }
  ],

  "layout": {
    "type": "grid",
    "columns": 12,
    "rowHeight": 50,
    "desktop": [
      { "widgetId": "kpi-0-90", "x": 0, "y": 0, "width": 3, "height": 3 },
      { "widgetId": "kpi-91-180", "x": 3, "y": 0, "width": 3, "height": 3 },
      { "widgetId": "kpi-181-365", "x": 6, "y": 0, "width": 3, "height": 3 },
      { "widgetId": "kpi-over-365", "x": 9, "y": 0, "width": 3, "height": 3 },

      {
        "widgetId": "table-raw-aging-matrix",
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 20
      }
    ],
    "mobile": [
      { "widgetId": "kpi-0-90" },
      { "widgetId": "kpi-91-180" },
      { "widgetId": "kpi-181-365" },
      { "widgetId": "kpi-over-365" },
      { "widgetId": "table-raw-aging-matrix" }
    ]
  }
}
