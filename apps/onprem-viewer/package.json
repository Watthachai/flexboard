{
  "name": "onprem-viewer-ui",
  "version": "5.15.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"next dev --turbopack -H 0.0.0.0 -p 3002\" \"tsx scripts/cron-worker.ts\" --names \"UI,SYNC\" --prefix-colors \"cyan,magenta\"",
    "dev:ui-only": "next dev --turbopack -H 0.0.0.0 -p 3002",
    "dev:show-ip": "node scripts/show-network-info.js && concurrently \"next dev --turbopack -H 0.0.0.0 -p 3002\" \"tsx scripts/cron-worker.ts\" --names \"UI,SYNC\" --prefix-colors \"cyan,magenta\"",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3002",
    "start:onprem": "node scripts/show-network-info.js && NODE_ENV=production next start -H 0.0.0.0 -p 3002",
    "show-ip": "node scripts/show-network-info.js",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "ingest": "tsx src/lib/ingest/ingest-job.ts",
    "ingest:watch": "nodemon --watch data --ext xml --exec \"npm run ingest\"",
    "cron:dev": "tsx scripts/cron-worker.ts",
    "cron:prod": "node dist/cron-worker.js",
    "setup:onprem": "node scripts/setup-onprem.js"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.3.16",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dayjs": "^1.11.13",
    "fast-xml-parser": "^5.2.5",
    "lucide-react": "^0.469.0",
    "mysql2": "^3.14.3",
    "next": "15.3.5",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.10",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.1.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tsx": "^4.20.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xlsx": "^0.0.36",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "prisma": "^6.15.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
