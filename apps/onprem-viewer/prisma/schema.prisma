datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model VVPVSG_INVENTORY_001_VIEW_001 {
  dataDate             DateTime
  corp                 String
  branch               String
  prodCode             String
  prodName             String
  prodGrp              String?
  unitName             String
  docNumber            String
  docDate              DateTime
  qtyFromThisDoc       Float
  buyPrice             Float?
  averageCost          Float
  totalFromBuyPrice    Float?
  totalFromAverageCost Float?
  daysAge              Int?
  ageBucket            String?
  createDate           DateTime @default(now())

  @@id([dataDate, corp, branch, prodCode, docNumber])
  @@index([dataDate])
  @@index([branch])
  @@index([prodCode])
  @@index([prodName])
  @@index([prodGrp])
  @@index([docNumber])
  @@index([ageBucket])
  @@index([corp])
}
