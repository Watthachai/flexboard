{
  "schemaVersion": "1.3",
  "dashboardId": "pvs-co-ltd-inventory-aging-report",
  "dashboardName": "PVS Inventory Aging Summary",
  "description": "RAW + Matrix-style header (show all rows) + Totals + Export",
  "version": 7,

  "theme": {
    "dark": true,
    "brandColor": "#7c3aed",
    "radius": "20px",
    "statusColors": {
      "ok": "#10b981",
      "warning": "#f59e0b",
      "danger": "#ef4444"
    }
  },

  "settings": { "nearExpiryDays": 45, "criticalDays": 14 },

  "formatters": {
    "date": {
      "kind": "date",
      "timezone": "Asia/Bangkok",
      "pattern": "dd MMM yyyy"
    },
    "qty": { "kind": "number", "precision": 0, "thousandsSep": "," },
    "money": {
      "kind": "number",
      "precision": 2,
      "thousandsSep": ",",
      "prefix": "฿"
    },
    "days": { "kind": "number", "precision": 0 }
  },

  "dataSources": [
    {
      "id": "uploaded-xml",
      "type": "local",
      "accept": [".xml", ".csv", ".json"],
      "fieldTypes": {
        "DataDate": "date",
        "Corp": "string",
        "Branch": "string",
        "Prod": "string",
        "UnitName": "string",
        "DocNumber": "string",
        "DocDate": "date",
        "QtyFromThisDoc": "number",
        "AverageCost": "number"
      },
      "dateParsing": { "DataDate": "yyyy-MM-dd", "DocDate": "yyyy-MM-dd" }
    }
  ],

  "transforms": [
    { "as": "QtySafe", "expr": "coalesce(QtyFromThisDoc, 0)" },
    { "as": "CostSafe", "expr": "coalesce(AverageCost, 0)" },

    { "as": "DaysAge", "expr": "dateDiff(DataDate, DocDate, 'days')" },
    {
      "as": "AgeBucket",
      "expr": "case(DaysAge > 365, '>365', DaysAge > 180, '181-365', DaysAge > 90, '91-180', DaysAge >= 0, '0-90', true, 'Expired')"
    },
    { "as": "TotalValueRow", "expr": "QtySafe * CostSafe" },

    {
      "as": "Qty_Expired_row",
      "expr": "case(AgeBucket = 'Expired',  QtySafe,        true, 0)"
    },
    {
      "as": "Val_Expired_row",
      "expr": "case(AgeBucket = 'Expired',  TotalValueRow,  true, 0)"
    },

    {
      "as": "Qty_0_90_row",
      "expr": "case(AgeBucket = '0-90',     QtySafe,        true, 0)"
    },
    {
      "as": "Val_0_90_row",
      "expr": "case(AgeBucket = '0-90',     TotalValueRow,  true, 0)"
    },

    {
      "as": "Qty_91_180_row",
      "expr": "case(AgeBucket = '91-180',   QtySafe,        true, 0)"
    },
    {
      "as": "Val_91_180_row",
      "expr": "case(AgeBucket = '91-180',   TotalValueRow,  true, 0)"
    },

    {
      "as": "Qty_181_365_row",
      "expr": "case(AgeBucket = '181-365',  QtySafe,        true, 0)"
    },
    {
      "as": "Val_181_365_row",
      "expr": "case(AgeBucket = '181-365',  TotalValueRow,  true, 0)"
    },

    {
      "as": "Qty_365_plus_row",
      "expr": "case(AgeBucket = '>365',     QtySafe,        true, 0)"
    },
    {
      "as": "Val_365_plus_row",
      "expr": "case(AgeBucket = '>365',     TotalValueRow,  true, 0)"
    }
  ],

  "globalFilters": [
    {
      "field": "DataDate",
      "op": ">=",
      "value": "addMonths(endOfMonth(today()), -6)",
      "description": "ตั้งแต่สิ้นเดือนที่ 6 เดือนย้อนหลัง (คำนวณอัตโนมัติ)"
    },
    {
      "field": "DataDate",
      "op": "<=",
      "value": "endOfMonth(today())",
      "description": "จนถึงสิ้นเดือนปัจจุบัน (คำนวณอัตโนมัติ)"
    }
  ],

  "userFilters": [
    {
      "id": "period-filter",
      "field": "DataDate",
      "label": "ช่วงเวลาข้อมูล",
      "type": "select",
      "defaultValue": "last_7_months",
      "options": [
        {
          "label": "7 เดือนล่าสุด (ปัจจุบัน + ย้อนหลัง 6 เดือน)",
          "value": "last_7_months",
          "filter": null
        },
        {
          "label": "ทุกข้อมูล (ไม่กรอง)",
          "value": "all_data",
          "filter": null
        }
      ]
    }
  ],

  "widgets": [
    {
      "id": "kpi-0-90",
      "type": "kpi",
      "title": "0–90 วัน (สดใหม่)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": "0-90" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "ok" }]
      }
    },
    {
      "id": "kpi-91-180",
      "type": "kpi",
      "title": "91–180 วัน (เริ่มเก่า)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": "91-180" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "warning" }]
      }
    },
    {
      "id": "kpi-181-365",
      "type": "kpi",
      "title": "181–365 วัน (เสี่ยง)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": "181-365" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "danger" }]
      }
    },
    {
      "id": "kpi-over-365",
      "type": "kpi",
      "title": ">365 วัน (เก่าเก็บ)",
      "dataSource": "uploaded-xml",
      "query": {
        "measures": [{ "field": "TotalValueRow", "agg": "sum", "as": "Value" }],
        "filters": [{ "field": "AgeBucket", "op": "=", "value": ">365" }]
      },
      "display": {
        "valueFormatter": "money",
        "severityRules": [{ "op": ">", "value": 0, "color": "danger" }]
      }
    },

    {
      "id": "table-summary-by-product",
      "type": "table",
      "title": "สรุปสต็อกตามสินค้า (จัดกลุ่มตามช่วงอายุ)",
      "dataSource": "uploaded-xml",
      "query": {
        "groupBy": ["Corp", "Branch", "Prod", "UnitName"],
        "measures": [
          { "field": "Qty_Expired_row", "agg": "sum", "as": "Qty_Expired" },
          { "field": "Val_Expired_row", "agg": "sum", "as": "Val_Expired" },
          { "field": "Qty_0_90_row", "agg": "sum", "as": "Qty_0_90" },
          { "field": "Val_0_90_row", "agg": "sum", "as": "Val_0_90" },
          { "field": "Qty_91_180_row", "agg": "sum", "as": "Qty_91_180" },
          { "field": "Val_91_180_row", "agg": "sum", "as": "Val_91_180" },
          { "field": "Qty_181_365_row", "agg": "sum", "as": "Qty_181_365" },
          { "field": "Val_181_365_row", "agg": "sum", "as": "Val_181_365" },
          { "field": "Qty_365_plus_row", "agg": "sum", "as": "Qty_365_plus" },
          { "field": "Val_365_plus_row", "agg": "sum", "as": "Val_365_plus" },
          { "field": "TotalValueRow", "agg": "sum", "as": "TotalValue" },
          { "field": "QtyFromThisDoc", "agg": "sum", "as": "TotalQty" }
        ],
        "sort": [{ "field": "Prod", "dir": "asc" }]
      },
      "display": {
        "widgetKind": "AdvancedTableWidget",
        "searchable": true,
        "enableExportExcel": true,
        "stickyHeader": true,
        "stickyFirstColumns": 4,
        "horizontalScroll": true,
        "pageSize": 25,
        "pageSizeOptions": [10, 25, 50, 100],

        "columnGroups": [
          {
            "title": "ข้อมูลสินค้า",
            "columns": ["Corp", "Branch", "Prod", "UnitName"]
          },
          { "title": "หมดอายุแล้ว", "columns": ["Qty_Expired", "Val_Expired"] },
          { "title": "0–90 วัน (สดใหม่)", "columns": ["Qty_0_90", "Val_0_90"] },
          {
            "title": "91–180 วัน (เริ่มเก่า)",
            "columns": ["Qty_91_180", "Val_91_180"]
          },
          {
            "title": "181–365 วัน (เสี่ยง)",
            "columns": ["Qty_181_365", "Val_181_365"]
          },
          {
            "title": "มากกว่า 365 วัน (เก่าเก็บ)",
            "columns": ["Qty_365_plus", "Val_365_plus"]
          },
          { "title": "รวมทั้งหมด", "columns": ["TotalQty", "TotalValue"] }
        ],

        "columnLabels": {
          "Corp": "บริษัท",
          "Branch": "สาขา",
          "Prod": "สินค้า",
          "UnitName": "หน่วย",
          "Qty_Expired": "จำนวน",
          "Val_Expired": "มูลค่า",
          "Qty_0_90": "จำนวน",
          "Val_0_90": "มูลค่า",
          "Qty_91_180": "จำนวน",
          "Val_91_180": "มูลค่า",
          "Qty_181_365": "จำนวน",
          "Val_181_365": "มูลค่า",
          "Qty_365_plus": "จำนวน",
          "Val_365_plus": "มูลค่า",
          "TotalQty": "จำนวนรวม",
          "TotalValue": "มูลค่ารวม"
        },

        "columnFormatters": {
          "Qty_Expired": "qty",
          "Val_Expired": "money",
          "Qty_0_90": "qty",
          "Val_0_90": "money",
          "Qty_91_180": "qty",
          "Val_91_180": "money",
          "Qty_181_365": "qty",
          "Val_181_365": "money",
          "Qty_365_plus": "qty",
          "Val_365_plus": "money",
          "TotalQty": "qty",
          "TotalValue": "money"
        },

        "columnAlignment": {
          "Qty_Expired": "right",
          "Val_Expired": "right",
          "Qty_0_90": "right",
          "Val_0_90": "right",
          "Qty_91_180": "right",
          "Val_91_180": "right",
          "Qty_181_365": "right",
          "Val_181_365": "right",
          "Qty_365_plus": "right",
          "Val_365_plus": "right",
          "TotalQty": "right",
          "TotalValue": "right"
        },

        "showTotalsRow": true,
        "totalsAgg": {
          "Qty_Expired": "sum",
          "Val_Expired": "sum",
          "Qty_0_90": "sum",
          "Val_0_90": "sum",
          "Qty_91_180": "sum",
          "Val_91_180": "sum",
          "Qty_181_365": "sum",
          "Val_181_365": "sum",
          "Qty_365_plus": "sum",
          "Val_365_plus": "sum",
          "TotalQty": "sum",
          "TotalValue": "sum"
        },

        "rowClassRules": [
          {
            "when": { "field": "Qty_Expired", "op": ">", "value": 0 },
            "className": "bg-red-50 border-l-4 border-red-500"
          },
          {
            "when": { "field": "Qty_365_plus", "op": ">", "value": 0 },
            "className": "bg-orange-50 border-l-4 border-orange-500"
          },
          {
            "when": { "field": "Qty_181_365", "op": ">", "value": 0 },
            "className": "bg-yellow-50 border-l-4 border-yellow-500"
          }
        ]
      }
    },

    {
      "id": "table-raw-aging-matrix",
      "type": "table",
      "title": "Raw Records (All Rows) — Matrix Header",
      "dataSource": "uploaded-xml",
      "query": {
        "columns": [
          "DataDate",
          "Corp",
          "Branch",
          "Prod",
          "UnitName",
          "DocNumber",
          "DocDate",
          "QtyFromThisDoc",
          "AverageCost",
          "DaysAge",
          "AgeBucket",
          "TotalValueRow"
        ],
        "sort": [{ "field": "Prod", "dir": "asc" }]
      },
      "display": {
        "widgetKind": "AdvancedTableWidget",
        "searchable": true,
        "enableExportExcel": true,
        "stickyHeader": true,
        "stickyFirstColumns": 3,
        "rowVirtualization": true,
        "pageSize": 50,
        "pageSizeOptions": [25, 50, 100, 200, 500],

        "columnGroups": [
          {
            "title": "ข้อมูลพื้นฐาน",
            "columns": [
              "DataDate",
              "Corp",
              "Branch",
              "Prod",
              "UnitName",
              "DocNumber",
              "DocDate",
              "QtyFromThisDoc",
              "AverageCost"
            ]
          },
          {
            "title": "การคำนวณอายุ",
            "columns": ["DaysAge", "AgeBucket", "TotalValueRow"]
          }
        ],

        "columnLabels": {
          "DataDate": "วันที่ข้อมูล",
          "Corp": "บริษัท",
          "Branch": "สาขา",
          "Prod": "สินค้า",
          "UnitName": "หน่วย",
          "DocNumber": "เลขที่เอกสาร",
          "DocDate": "วันที่เอกสาร",
          "QtyFromThisDoc": "Quantity",
          "AverageCost": "Unit Cost",
          "DaysAge": "Days Age",
          "AgeBucket": "Bucket",
          "TotalValueRow": "Total Value",
          "Qty_Expired_row": "Quantity",
          "Val_Expired_row": "Value",
          "Qty_0_90_row": "Quantity",
          "Val_0_90_row": "Value",
          "Qty_91_180_row": "Quantity",
          "Val_91_180_row": "Value",
          "Qty_181_365_row": "Quantity",
          "Val_181_365_row": "Value",
          "Qty_365_plus_row": "Quantity",
          "Val_365_plus_row": "Value"
        },

        "columnFormatters": {
          "DataDate": "date",
          "DocDate": "date",
          "QtyFromThisDoc": "qty",
          "AverageCost": "money",
          "TotalValueRow": "money",
          "DaysAge": "days",
          "Qty_Expired_row": "qty",
          "Val_Expired_row": "money",
          "Qty_0_90_row": "qty",
          "Val_0_90_row": "money",
          "Qty_91_180_row": "qty",
          "Val_91_180_row": "money",
          "Qty_181_365_row": "qty",
          "Val_181_365_row": "money",
          "Qty_365_plus_row": "qty",
          "Val_365_plus_row": "money"
        },

        "showTotalsRow": true,
        "totalsAgg": {
          "QtyFromThisDoc": "sum",
          "TotalValueRow": "sum",
          "Qty_Expired_row": "sum",
          "Val_Expired_row": "sum",
          "Qty_0_90_row": "sum",
          "Val_0_90_row": "sum",
          "Qty_91_180_row": "sum",
          "Val_91_180_row": "sum",
          "Qty_181_365_row": "sum",
          "Val_181_365_row": "sum",
          "Qty_365_plus_row": "sum",
          "Val_365_plus_row": "sum"
        },

        "rowClassRules": [
          {
            "when": { "field": "AgeBucket", "op": "=", "value": "Expired" },
            "className": "bg-red-900/20"
          },
          {
            "when": { "field": "AgeBucket", "op": "=", "value": "0-90" },
            "className": "bg-yellow-900/30"
          },
          {
            "when": { "field": "AgeBucket", "op": "=", "value": "91-180" },
            "className": "bg-orange-900/20"
          }
        ]
      }
    }
  ],

  "layout": {
    "type": "grid",
    "columns": 12,
    "rowHeight": 50,
    "desktop": [
      { "widgetId": "kpi-0-90", "x": 0, "y": 0, "width": 3, "height": 3 },
      { "widgetId": "kpi-91-180", "x": 3, "y": 0, "width": 3, "height": 3 },
      { "widgetId": "kpi-181-365", "x": 6, "y": 0, "width": 3, "height": 3 },
      { "widgetId": "kpi-over-365", "x": 9, "y": 0, "width": 3, "height": 3 },
      {
        "widgetId": "table-summary-by-product",
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 15
      },
      {
        "widgetId": "table-raw-aging-matrix",
        "x": 0,
        "y": 18,
        "width": 12,
        "height": 20
      }
    ],
    "mobile": [
      { "widgetId": "kpi-0-90" },
      { "widgetId": "kpi-91-180" },
      { "widgetId": "kpi-181-365" },
      { "widgetId": "kpi-over-365" },
      { "widgetId": "table-summary-by-product" },
      { "widgetId": "table-raw-aging-matrix" }
    ]
  }
}
